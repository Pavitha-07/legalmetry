APP_NAME=LegalMetry API
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://legalmetry:legalmetry@postgres:5432/legalmetry
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated list of allowed frontend origins.
# For Expo web dev: http://localhost:8081,http://127.0.0.1:8081
# For production:   https://legalmetry.example.gov.in
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=replace-with-a-unique-user
MINIO_ROOT_PASSWORD=replace-with-a-long-password
MINIO_BUCKET=inspection-evidence
MINIO_SECURE=false
REDIS_URL=redis://redis:6379/0
INITIAL_SUPERVISOR_EMAIL=supervisor@example.gov.in
INITIAL_SUPERVISOR_PASSWORD=change-this-before-starting
SINGLE_DISTRICT_NAME=Demo District
# Optional. Without these, declaration extraction falls back to the
# PaddleOCR-only pipeline (slower, no structured vision-model read).
GROQ_API_KEY=
GEMINI_API_KEY=
