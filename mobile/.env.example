# Expo public env vars — these are baked into the JS bundle at build time.
# Rename this file to .env for local development, or set these in your
# EAS build profile (eas.json) for production builds.
#
# Production example:
#   EXPO_PUBLIC_API_URL=https://api.legalmetry.example.gov.in
#
# Local dev (Expo Go on a phone needs the LAN IP, not localhost):
#   EXPO_PUBLIC_API_URL=http://192.168.X.X:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
