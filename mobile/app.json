{
  "expo": {
    "name": "LegalMetry",
    "slug": "legalmetry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D10",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LegalMetry to capture package panels."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LegalMetry to upload package panel photos."
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gov.legalmetry"
    },
    "android": {
      "package": "in.gov.legalmetry",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fffb95d1-0846-4e02-8f10-f2aaba1b7a6e"
      }
    }
  }
}
